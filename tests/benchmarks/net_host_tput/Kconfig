config BENCH_LOCAL_RAM_HOTPATH
	bool "Place the UDP TX hot path in core-local RAM (APP_RAM0)"
	select CODE_DATA_RELOCATION

config BENCH_HOTPATH_REGION
	string "Linker region for the UDP TX hot path"
	depends on BENCH_LOCAL_RAM_HOTPATH
	default "APPTCM_TEXT"
	help
	  APPTCM_TEXT is the nRF54H20 app core local RAM (tcm.overlay). Parts
	  without core-local RAM, such as nRF7120, use SRAMCODE_TEXT together
	  with sramcode.overlay.

config BENCH_HOTPATH_CSUM_IN_NVM
	bool "Keep the checksum (utils.c) out of the relocated hot path"
	depends on BENCH_LOCAL_RAM_HOTPATH
	help
	  On nRF7120, code in SRAM is fetched over the same S-AHB port as its
	  data, so the load-heavy checksum loop runs faster from cached MRAM.

config BENCH_NULL_ETH
	bool "Ethernet L2 sink driver instead of loopback"
	depends on NET_L2_ETHERNET
	select NET_CHECKSUM_OFFLOAD_SUPPORTED

config BENCH_NULL_ETH_CSUM_OFFLOAD
	bool "Advertise TX/RX checksum offload from the sink driver"
	depends on BENCH_NULL_ETH

source "$(ZEPHYR_BASE)/samples/net/zperf/Kconfig"
