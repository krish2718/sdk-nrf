source "Kconfig.zephyr"

choice SHUTDOWN_OPERATION_MODE
	prompt "Sample operation mode"
	default OPERATION_MODE_CONTINUOUS
	help
	  Select the operation mode for the sample.

config OPERATION_MODE_CONTINUOUS
	bool "Continuous mode"
	help
	  In this mode, the sample will continue to run alternating between
	  Wi-Fi shutdown and startup.

config OPERATION_MODE_ONE_SHOT
	bool "One-shot mode"
	help
	  In this mode, the sample will shutdown Wi-Fi only once and then exit.

config OPERATION_MODE_BUTTONS
	bool "Enable button interaction"
	help
	  Enable button interaction in the sample. If enabled, the sample will
	  enable use of buttons to toggle the Wi-Fi shutdown or startup.

config OPERATION_MODE_BOOT_DOWN_IDLE
	bool "Boot, bring interface down, idle for current measurement"
	help
	  After boot (and optional MAC setup), bring the default network
	  interface down once, suspend the console when
	  CONFIG_NRF71_IDLE_POWER is enabled, then sleep forever. No scan
	  and no stay-up leg. Pair with the nrf71-idle-power-quiet snippet
	  (CONFIG_SERIAL=n) so PD_PERIP is not kept up by UART during
	  measurement.
endchoice

config SHUTDOWN_BOOT_DOWN_SETTLE_MS
	int "Delay before net_if down in boot-down-idle mode (ms)"
	default 500
	depends on OPERATION_MODE_BOOT_DOWN_IDLE
	help
	  Wait for Wi-Fi driver and auto-start interface bring-up to finish
	  before calling net_if_down().

config SHUTDOWN_TIMEOUT_S
	int "Wi-Fi shutdown timeout"
	default 5
	help
	  Timeout in seconds after the Wi-Fi shutdown operation.

config SHUTDOWN_STAY_UP
	bool "Stay up with Wi-Fi interface up for idle measurement"
	help
	  For idle-current measurement with the interface up. In one-shot or
	  buttons mode, bring the interface up and scan once, then idle
	  forever with the interface still up instead of bringing Wi-Fi down.
	  Lets the driver's power save put the radio to sleep between beacons
	  while the host idles.
